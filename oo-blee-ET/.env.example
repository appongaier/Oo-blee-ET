# Copy to .env (Windows CMD: copy .env.example .env). Never commit .env.

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Leave empty for local Docker; set for FalkorDB Cloud (e.g. falkordb)
FALKORDB_USERNAME=
# Leave empty for the local Docker setup (port is bound to localhost only).
FALKORDB_PASSWORD=

# --- Docker Compose host ports ---
FALKORDB_BROWSER_PORT=3000

# --- API ---
API_CORS_ORIGINS=http://localhost:5173

# Deletion receipts are written here as JSON (empty = do not write files)
RECEIPT_DIR=receipts

# Lets the UI wipe and reseed the synthetic demo graphs. Set false anywhere shared.
DEMO_CONTROLS=true

# MCP audit log (JSON Lines: tool calls and agent handoffs; empty = off)
MCP_LOG_PATH=logs/mcp.jsonl

# --- LLM ---
GEMINI_API_KEY=
# Model used by the agents (e.g. gemini-2.5-flash or gemini-1.5-flash)
LLM_MODEL=gemini-2.5-flash

# Alternate: Anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

